{
  "name": "express-ogc-api",
  "version": "1.0.0",
  "description": "Modern Express.js middleware for OGC API standards",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/am2222/express-ogc-api.git"
  },
  "homepage": "https://github.com/am2222/express-ogc-api#readme",
  "bugs": {
    "url": "https://github.com/am2222/express-ogc-api/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && tsc-alias --resolve-full-paths",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/example-duckdb-provider.ts",
    "test": "vitest run",
    "test:debug": "vitest --inspect-brk",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "express",
    "middleware",
    "ogc",
    "ogc-api",
    "geospatial",
    "gis"
  ],
  "author": "Majid Hojati",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.27",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^8.55.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "prettier": "^3.1.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.3",
    "@types/geojson": "^7946.0.16",
    "@types/json-schema": "^7.0.15",
    "cql2-wasm": "^0.5.6"
  }
}
