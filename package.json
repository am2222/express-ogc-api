{
  "name": "express-ogc-api",
  "version": "1.0.0",
  "description": "Modern Express.js middleware for OGC API standards",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "example": "tsx examples/example-duckdb-provider.ts",
    "test": "vitest",
    "test:debug": "vitest --inspect-brk",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "express",
    "middleware",
    "ogc",
    "ogc-api",
    "geospatial",
    "gis"
  ],
  "author": "Majid Hojati",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.27",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^8.55.0",
    "express": "^4.18.2",
    "prettier": "^3.1.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.4.3-r.1",
    "cql2-wasm": "^0.5.6",
    "duckdb-async": "^1.4.2",
    "express": "^4.18.0 || ^5.0.0",
    "express-jsdoc-swagger": "^1.8.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}
